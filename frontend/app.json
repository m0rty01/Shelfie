{
  "expo": {
    "name": "Shelfie",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_shelfie.png",
    "splash": {
      "image": "./assets/images/splash-image_shelfie.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelfie.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan bookshelves to build your library.",
        "NSPhotoLibraryUsageDescription": "Pick a bookshelf photo to scan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon_shelfie.png",
        "backgroundColor": "#FDFBF7"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.shelfie.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon_shelfie.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image_shelfie.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your bookshelves to build your library."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of your bookshelf to scan.",
          "cameraPermission": "Scan your bookshelves to build your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
